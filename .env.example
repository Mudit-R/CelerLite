# Optional: override any config value locally
# Copy this to .env and adjust values

CELERLITE_REDIS_URL=redis://localhost:6379/0
CELERLITE_DATABASE_URL=postgresql+asyncpg://celerlite:celerlite@localhost:5432/celerlite
CELERLITE_WORKER_CONCURRENCY=4
CELERLITE_MAX_RETRIES=3
CELERLITE_HEARTBEAT_INTERVAL=10
CELERLITE_HEARTBEAT_TIMEOUT=30
CELERLITE_API_PORT=8000
CELERLITE_LOG_LEVEL=INFO
CELERLITE_LOG_FORMAT=json
