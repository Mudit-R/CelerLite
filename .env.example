# Optional: override any config value locally
# Copy this to .env and adjust values

CELERLITE_REDIS_URL=redis://localhost:6379/0
CELERLITE_DATABASE_URL=postgresql+asyncpg://celerlite:celerlite@localhost:5432/celerlite
CELERLITE_WORKER_CONCURRENCY=4
CELERLITE_MAX_RETRIES=3
CELERLITE_HEARTBEAT_INTERVAL=10
CELERLITE_HEARTBEAT_TIMEOUT=30
CELERLITE_API_PORT=8000
CELERLITE_LOG_LEVEL=INFO
CELERLITE_LOG_FORMAT=json

# Private shared-workspace login. Populate before starting the application.
# Use a Supabase publishable key (or legacy anon key), never a secret/service key.
CELERLITE_AUTH_REQUIRED=true
CELERLITE_SUPABASE_URL=https://your-project.supabase.co
CELERLITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
CELERLITE_AUTH_ALLOWED_USER_IDS=replace-with-approved-supabase-user-uuid
CELERLITE_AUTH_PUBLIC_ORIGIN=http://localhost:8000
# Set false only for localhost HTTP; public HTTPS must use true.
CELERLITE_AUTH_COOKIE_SECURE=false
